<?xml version="1.0" encoding="utf-8"?>
<!--
    TextPage.xaml —— 文本页（粘贴板式表格页：左列备注 + 右列文本，**点击一行即复制**）

    这是 WinUI 线新增的**第三种页**（原版 Python 只有网格页与列表页，见 Core 的 TabModel.TypeText）。
    形态照列表页（`ListViewPage`）：紧凑行高、两列、右键菜单；
    差别有三处，都在这里与 .xaml.cs 里写明：
      ① **带一行表头**（备注 / 文本 + "点击一行即可复制它的文本"的提示）——
         两列的含义不像"说明 / 路径"那么自明，表头是必须的；
      ② 行**不可拖**（`CanDrag=False`）：文本页本轮不做拖拽排序，见 .xaml.cs 顶部说明；
      ③ 点一行 = **复制**（不是"打开"）。

    ⚠️ 文案走 `ui:Tr.Key`（静态文字）+ 代码里取 Core 常量（对话框与提示），与其它页同一分工。
-->
<UserControl
    x:Class="ToolboxPanel.Views.TextPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:ToolboxPanel"
    xmlns:vm="using:ToolboxPanel.ViewModels">

    <UserControl.Resources>
        <Style x:Key="CompactTextRowStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <!--
                ⚠️⚠️ 2026-10-02：与列表页同一条修正 —— `ListViewItem` 默认水平对齐是 **Left**，
                行只占"自己内容的宽度" ⇒ 星号列按每行各自宽度分 ⇒ **第二列参差不齐**。
                Stretch 之后所有行同宽，分界点统一 = 表格观感（用户实测反馈的那一条）。
            -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!--
                ⚠️ 文本页**刻意不开 CanDrag**（与列表页相反）：
                这一页本轮不做拖拽排序，开了只会让"想选中/点一下复制"变成"莫名其妙拖起来"。
                要加拖拽时记得三件事一起做：载荷类型、目标页门控、Core 的落库入口。
            -->
            <Setter Property="CanDrag" Value="False" />
        </Style>

        <!--
            两列的列宽定义在**表头与行模板里各写一份**（XAML 没有"共享列宽"的机制）：
            值必须逐字一致，否则表头与内容会错位。改宽度请改两处。
            ⚠️ 表头与行**都必须撑满宽度**：行靠容器的 HorizontalContentAlignment=Stretch（见上），
               表头靠这里显式 Stretch（它不在行容器里，走的是另一条宿主）。
        -->
        <DataTemplate x:Key="TextRowTemplate" x:DataType="vm:TextRowViewModel">
            <Grid ColumnSpacing="10" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <!-- ⚠️ Mode=OneWay：编辑属性之后要能**就地刷新**（x:Bind 默认是 OneTime） -->
                <TextBlock Grid.Column="0" Text="{x:Bind Note, Mode=OneWay}"
                           FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1" Text="{x:Bind Text, Mode=OneWay}"
                           FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ListView x:Name="Rows"
                  ItemTemplate="{StaticResource TextRowTemplate}"
                  ItemContainerStyle="{StaticResource CompactTextRowStyle}"
                  HorizontalContentAlignment="Stretch"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnRowClick"
                  ContextRequested="OnRowContextRequested"
                  Padding="6,4"
                  Background="Transparent">

            <!-- 表头：两列的含义不像"说明 / 路径"那么自明，所以给它一行标题 + 一句怎么用 -->
            <ListView.Header>
                <Grid ColumnSpacing="10" Padding="8,2" Margin="0,0,0,4" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" ui:Tr.Key="text.col.note"
                               FontSize="11" FontWeight="SemiBold" Opacity="0.75"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock ui:Tr.Key="text.col.text"
                                   FontSize="11" FontWeight="SemiBold" Opacity="0.75" />
                        <TextBlock ui:Tr.Key="text.copy_hint"
                                   FontSize="11" Opacity="0.45"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </ListView.Header>

            <!--
                ⚠️ 只保留 ReorderThemeTransition（与网格页/列表页同一条实测结论）：
                默认的 ItemContainerTransitions 带 EntranceThemeTransition，条目一变化
                就会"所有行重新进入一次"（观感 = 整页闪一下）。
            -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <ReorderThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
        </ListView>

        <!-- 空页提示：这一页**一条都没有**（引导去右键新建） -->
        <StackPanel x:Name="EmptyHint"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="6" Visibility="Collapsed">
            <FontIcon Glyph="&#xE8C8;" FontSize="32" Opacity="0.45" />
            <TextBlock ui:Tr.Key="text.empty_title" Opacity="0.65" FontSize="12" />
            <TextBlock ui:Tr.Key="text.empty_hint" Opacity="0.4" FontSize="10.5" />
        </StackPanel>

        <!--
            搜索无匹配提示（**这一页有内容，但当前查询一个都没命中**）——
            与空页提示是两个状态：前者引导去新建，后者引导改关键词 / 关搜索。
        -->
        <StackPanel x:Name="NoMatchHint"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="6" Visibility="Collapsed">
            <FontIcon Glyph="&#xE721;" FontSize="32" Opacity="0.45" />
            <TextBlock x:Name="NoMatchText" Opacity="0.65" FontSize="12" />
            <TextBlock ui:Tr.Key="search.no_match_hint" Opacity="0.4" FontSize="10.5"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
