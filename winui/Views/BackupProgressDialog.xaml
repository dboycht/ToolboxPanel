<?xml version="1.0" encoding="utf-8"?>
<!--
    BackupProgressDialog.xaml —— 导出 / 导入备份的进度对话框

    照原版 ProgressDialog 的语义：
      · 进度条 + 滚动日志（逐条显示"压缩: xxx / 解压: xxx"）；
      · **操作进行中不允许关闭**（原版文案："操作进行中，无法关闭"）；
      · 结束后把结果写在底部一行（成功给路径，失败给原因）。
-->
<ContentDialog
    x:Class="ToolboxPanel.Views.BackupProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close">

    <StackPanel Spacing="10" MinWidth="380">
        <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" Value="0" />

        <ScrollViewer x:Name="LogScroller" Height="180"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      Padding="8,6">
            <TextBlock x:Name="LogText"
                       FontFamily="Consolas, Microsoft YaHei UI"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </ScrollViewer>

        <TextBlock x:Name="ResultText"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
