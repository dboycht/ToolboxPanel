<?xml version="1.0" encoding="utf-8"?>
<!--
    SettingsPanel.xaml —— 设置面板（单独面板，按"主题 / 窗口 / 标签栏 / 图标 / 动效 / 语言 / 数据"分节）

    约定：
      · 面板自己负责"改模型 + 立刻落盘"（SettingsStore），然后抛 SettingApplied 让主窗口重新套用；
      · 动效参数改动可以点「预览动效」立刻看效果（不用来回切标签页试）；
      · 关掉"启用动效"时，动效细则整体禁用（灰掉）但仍保留数值。

    ⚠️ 文案一律走 `ui:Tr.Key="<key>"`（元素主文案）与 `ui:Tr.Header="<key>"`（表单表头）——
       由 Core 的 I18n 取文案，语言一换由 Tr.RefreshAll() 统一重刷。
       不要在这里写死中文，也不要在代码里逐个赋值（见 Tr.cs 的说明）。
-->
<UserControl
    x:Class="ToolboxPanel.Views.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:ToolboxPanel">

    <!-- Esc 关闭（面板打开时会拿到焦点，见 MainWindow.ShowSettings） -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            标题栏：⚠️ 顶部留 44 DIP —— 窗口是 ExtendsContentIntoTitleBar，
            系统的最小化/最大化/关闭按钮就压在右上角（y 0~34），
            panel 自己的 ✕ 若贴在最上面会被它盖住且点不到（用户实测反馈）。
        -->
        <Grid Grid.Row="0" Padding="16,44,10,8">
            <TextBlock ui:Tr.Key="settings.title" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <!-- ⚠️ 同 ⚙：关掉焦点视觉，避免"看起来像被选中"（见 MainWindow.xaml 的说明） -->
            <Button HorizontalAlignment="Right" Padding="6,2"
                    Background="Transparent" BorderThickness="0"
                    UseSystemFocusVisuals="False"
                    FocusVisualPrimaryThickness="0"
                    FocusVisualSecondaryThickness="0"
                    Click="OnCloseClick" ui:Tr.Tip="settings.close_tip">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="16,0,16,16">
            <StackPanel Spacing="8">

                <!-- ── 主题 ── -->
                <TextBlock ui:Tr.Key="settings.section.theme" Style="{StaticResource SectionHeaderStyle}" />
                <RadioButtons x:Name="UiThemeChoices" ui:Tr.Header="settings.ui_theme"
                              SelectionChanged="OnUiThemeChanged">
                    <RadioButton ui:Tr.Key="settings.theme.system" Tag="system" />
                    <RadioButton ui:Tr.Key="theme.light" Tag="light" />
                    <RadioButton ui:Tr.Key="theme.dark" Tag="dark" />
                </RadioButtons>
                <TextBlock Style="{StaticResource SectionHintStyle}" ui:Tr.Key="settings.theme.hint" />

                <!-- ── 窗口 ── -->
                <TextBlock ui:Tr.Key="settings.section.window" Style="{StaticResource SectionHeaderStyle}" />
                <ComboBox x:Name="BackdropBox" ui:Tr.Header="settings.backdrop" HorizontalAlignment="Stretch"
                          SelectionChanged="OnBackdropChanged">
                    <ComboBoxItem ui:Tr.Key="settings.backdrop.mica" Tag="mica" />
                    <ComboBoxItem ui:Tr.Key="settings.backdrop.mica_alt" Tag="micaAlt" />
                    <ComboBoxItem ui:Tr.Key="settings.backdrop.acrylic" Tag="acrylic" />
                    <ComboBoxItem ui:Tr.Key="settings.backdrop.acrylic_thin" Tag="acrylicThin" />
                    <ComboBoxItem ui:Tr.Key="settings.backdrop.none" Tag="none" />
                </ComboBox>
                <TextBlock Style="{StaticResource SectionHintStyle}" ui:Tr.Key="settings.backdrop.hint" />

                <!-- ── 标签栏 ── -->
                <TextBlock ui:Tr.Key="settings.section.tabbar" Style="{StaticResource SectionHeaderStyle}" />
                <RadioButtons x:Name="TabIconModeChoices" ui:Tr.Header="settings.tab_icons"
                              SelectionChanged="OnTabIconModeChanged">
                    <RadioButton ui:Tr.Key="settings.tab_icons.text" Tag="text" />
                    <RadioButton ui:Tr.Key="settings.tab_icons.always" Tag="always" />
                    <RadioButton ui:Tr.Key="settings.tab_icons.hover" Tag="hover" />
                </RadioButtons>
                <ToggleSwitch x:Name="ShowCountsSwitch" ui:Tr.Header="settings.show_counts"
                              Toggled="OnShowCountsToggled" />
                <TextBlock Style="{StaticResource SectionHintStyle}" ui:Tr.Key="settings.tabbar.hint" />

                <!-- ── 图标 ── -->
                <TextBlock ui:Tr.Key="settings.section.icons" Style="{StaticResource SectionHeaderStyle}" />
                <RadioButtons x:Name="IconSizeChoices" ui:Tr.Header="settings.icon_size"
                              SelectionChanged="OnIconSizeChanged">
                    <RadioButton ui:Tr.Key="app.menu.size_small" Tag="small" />
                    <RadioButton ui:Tr.Key="settings.icon_size.medium" Tag="medium" />
                    <RadioButton ui:Tr.Key="app.menu.size_large" Tag="large" />
                </RadioButtons>
                <TextBlock Style="{StaticResource SectionHintStyle}" ui:Tr.Key="settings.icons.hint" />

                <!-- ── 动效 ── -->
                <TextBlock ui:Tr.Key="settings.section.animation" Style="{StaticResource SectionHeaderStyle}" />
                <ToggleSwitch x:Name="AnimationSwitch" ui:Tr.Header="settings.animations.enabled"
                              Toggled="OnAnimationsToggled" />

                <StackPanel x:Name="AnimationDetails" Spacing="6">
                    <Slider x:Name="DurationSlider" ui:Tr.Header="settings.animations.duration"
                            Minimum="60" Maximum="600" StepFrequency="20"
                            ValueChanged="OnDurationChanged" />
                    <ComboBox x:Name="EasingBox" ui:Tr.Header="settings.animations.easing" HorizontalAlignment="Stretch"
                              SelectionChanged="OnEasingChanged">
                        <ComboBoxItem ui:Tr.Key="settings.animations.soft" Tag="soft" />
                        <ComboBoxItem ui:Tr.Key="settings.animations.standard" Tag="standard" />
                        <ComboBoxItem ui:Tr.Key="settings.animations.snappy" Tag="snappy" />
                    </ComboBox>
                    <Button x:Name="PreviewButton" ui:Tr.Key="settings.animations.preview" Click="OnPreviewClick" />
                    <TextBlock Style="{StaticResource SectionHintStyle}" ui:Tr.Key="settings.animations.hint" />
                </StackPanel>

                <!-- ── 快捷键 ──
                     ⚠️ 入口**故意只放在这里**（2026-09-19 用户决定：从标题栏搬进来，标题栏不再放 ❓）。
                     理由：用户找"设置"的第一反应就是打开这个面板 —— 原来摆在标题栏那个 ❓ 图标上，
                     用户根本找不到（用户实际反馈就是"快捷键在哪里设置？"）。
                     面板只发事件，弹窗与落盘由宿主负责（与「导出/导入备份」同一套纪律）。
                     文案全用现成 key，**没有新增任何文案**。 -->
                <TextBlock ui:Tr.Key="shortcut.settings.title" Style="{StaticResource SectionHeaderStyle}" />
                <Button x:Name="ShortcutSettingsButton" ui:Tr.Key="action.edit" Margin="0,4,0,0"
                        Click="OnShortcutSettingsClick" />
                <TextBlock Style="{StaticResource SectionHintStyle}" ui:Tr.Key="shortcut.hint" />

                <!-- ── 语言 ── -->
                <TextBlock ui:Tr.Key="settings.language" Style="{StaticResource SectionHeaderStyle}" />
                <RadioButtons x:Name="LanguageChoices" ui:Tr.Header="settings.ui_language"
                              SelectionChanged="OnLanguageChanged">
                    <RadioButton ui:Tr.Key="settings.lang.zh" Tag="zh" />
                    <RadioButton ui:Tr.Key="settings.lang.en" Tag="en" />
                </RadioButtons>
                <TextBlock Style="{StaticResource SectionHintStyle}" ui:Tr.Key="settings.language.hint" />

                <!-- ── 数据（备份）── -->
                <TextBlock ui:Tr.Key="settings.section.data" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock x:Name="DataDirText" Style="{StaticResource SectionHintStyle}" Text="" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ExportBackupButton" ui:Tr.Key="settings.export" Click="OnExportBackupClick"
                            ui:Tr.Tip="settings.export.tip" />
                    <Button x:Name="ImportBackupButton" ui:Tr.Key="settings.import" Click="OnImportBackupClick"
                            ui:Tr.Tip="settings.import.tip" />
                </StackPanel>
                <TextBlock Style="{StaticResource SectionHintStyle}" ui:Tr.Key="settings.data.hint" />

                <!--
                    重置数据（原版 文件菜单 →「重置数据」Ctrl+Shift+R）：清空所有标签页与图标缓存。
                    ⚠️ 与面板底部的 `settings.reset_all`（**恢复默认设置**）是两件事，别混：
                    这个是删内容，那个是把 config.json 恢复默认值。所以按钮放在「数据」这一节里，
                    并把后果用 reset.confirm 的原文写在旁边 —— 点之前就知道会发生什么。
                -->
                <Button x:Name="ResetDataButton" ui:Tr.Key="reset.title" Margin="0,6,0,0"
                        Click="OnResetDataClick" />
                <TextBlock Style="{StaticResource SectionHintStyle}" ui:Tr.Key="reset.confirm" />

                <!-- ── 底部 ── -->
                <Button x:Name="ResetButton" ui:Tr.Key="settings.reset_all" Margin="0,12,0,0" Click="OnResetClick" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
