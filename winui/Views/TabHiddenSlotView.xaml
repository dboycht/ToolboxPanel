<?xml version="1.0" encoding="utf-8"?>
<!--
    TabHiddenSlotView 的默认模板（Control + ControlTemplate）

    ⚠️ 用"模板 + GetTemplateChild"而不是"按名字在父级模板里找元素"：
    后者会取到复用模板里的错误实例，实测表现为不同标签互相串。

    结构（最朴素、也最不容易错的一条）：
      · 根是**顺序排列**的 StackPanel（名字的宽度必须参与尺寸计算）；
      · `SlotHost` 是"隐藏项"的占位：收起时宽 0（里面完全看不见、也不占位），
        展开时动画到 66 —— 名字作为它的兄弟被自然推到右边；
      · 槽内容 `IsHitTestVisible=False`，所以槽的伸缩不会引发假的指针退出事件。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ToolboxPanel.Views">

    <Style TargetType="views:TabHiddenSlotView">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:TabHiddenSlotView">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">

                        <!-- 隐藏项占位：图标 + 数量文字（同一个槽 ⇒ 一定同进同出） -->
                        <Grid x:Name="SlotHost" Width="0" Opacity="0"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,200,40" />
                            </Grid.Clip>

                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Grid Width="16" VerticalAlignment="Center">
                                    <!--
                                        ⚠️ 前景色**显式声明**用框架主题资源（跟随元素主题解析）。
                                        之前这里没有任何 Foreground ⇒ 文字/图标**继承** ListViewItem 的前景，
                                        而"选中标签的前景"是本项目用轻量样式键覆盖的固定值：
                                        切主题时它**不会重新解析**（用户实测："切主题后上面的有些图标与文字没换"，
                                        浅色主题下选中标签仍是白字，实测像素 rgb(152,152,152)）。
                                        显式声明之后，颜色由元素主题决定，两套主题都必然正确
                                        （深色下仍是白字 = 外观不变，浅色下变深字）。
                                    -->
                                    <FontIcon Glyph="{TemplateBinding Glyph}" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Grid>

                                <TextBlock Text="{TemplateBinding CountLabel}" FontSize="10" Opacity="0.5"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{TemplateBinding ShowCount}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{TemplateBinding TabName}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
