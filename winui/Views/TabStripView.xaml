<?xml version="1.0" encoding="utf-8"?>
<!--
    TabStripView.xaml —— 标签栏（横向可滚动）

    三种图标形态（设置项 tab_icon_mode）：
      · text   ：只保留文字（与原版 v1.11.6 / QML 一致）
      · always ：常驻图标
      · hover  ：悬停时图标从文字左边浮现，标签随之整体拉伸

    ⚠️ 悬停判定必须做"去抖 + 范围复核"：图标槽变宽会让内容平移，
       WinUI 可能在指针没真的离开时抛 PointerExited，导致拉伸/缩回无限往复
       （用户实测反馈的 bug）。详见 TabStripView.xaml.cs 的注释。
-->
<UserControl
    x:Class="ToolboxPanel.Views.TabStripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ToolboxPanel.ViewModels"
    xmlns:views="using:ToolboxPanel.Views">

    <UserControl.Resources>
        <!--
            轻量样式覆盖（lightweight styling）：只改颜色、不动模板，
            把标签项的默认选中胶囊与焦点框换成"更亮的底 + 底部强调条"。
            ⚠️ 这些是**深色**的初值；浅色主题下由代码换掉（TabStripView.ApplyTheme），
            否则浅色主题会"白字白底"看不见（WinUI 的轻量样式覆盖键不会自己跟着 RequestedTheme 变）。
        -->
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#29FFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#22FFFFFF" />
        <!--
            ⚠️ 这里**刻意不再覆盖 `ListViewItemForegroundSelected`**：
            它是"轻量样式键"，切主题时**不会重新解析**（实测：切到浅色后选中标签仍是白字
            rgb(152,152,152)，而未选中标签已经是黑字 rgb(16,16,16)）。
            选中标签的文字/图标颜色改由 TabHiddenSlotView 模板**显式声明**框架主题资源
            （跟随元素主题，必然正确；深色下仍是白字，外观不变）。详见 ERROR.md E19。
        -->
        <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemFocusVisualPrimaryBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemFocusVisualSecondaryBrush" Color="Transparent" />

        <DataTemplate x:Key="TabItemTemplate" x:DataType="vm:TabItemViewModel">
            <!--
                ⚠️ 悬停判定**不在这里做**（模板上没有任何 Pointer 事件）：
                改由标签栏统一判定（TabStripView 的 PointerMoved，用**整个标签项**的范围命中），
                保证"鼠标在标签上就展开、移到别的标签时上一个立刻收起"，
                而且"同时最多只有一个展开"是结构性保证。

                名字与"隐藏项（图标 + 数量文字）"都在 `TabHiddenSlotView` 这一个控件里，
                由它自己保证"一个进、一个让"，不靠外面按名字找元素
                （按名字找会取到复用模板里的错误实例，实测过）。
            -->
            <Grid>
                <views:TabHiddenSlotView
                    x:Name="HiddenSlotView"
                    TabName="{x:Bind Name, Mode=OneWay}"
                    Glyph="{x:Bind Glyph}"
                    CountLabel="{x:Bind CountLabel, Mode=OneWay}"
                    ShowCount="{x:Bind ShowCount, Mode=OneWay}"
                    Loaded="OnHiddenSlotViewLoaded" />

                <!-- 选中态：底部 2px 强调条（颜色走主题令牌，见 TabStripView.ApplyTheme） -->
                <Border x:Name="SelectionBar" Height="2" Width="16" CornerRadius="1"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Background="{ThemeResource AccentBrushDark}"
                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="CompactTabItemStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="CornerRadius" Value="5" />
            <!--
                ⚠️ 焦点框必须**厚度归零**才真的消失：只把 FocusVisual*Brush 设成透明是不够的
                （那只是把画笔变透明，框仍然占位并可能被其它主题覆盖）。
                用户实测反馈"选中的标签外面有个框"，根因就是这里。
            -->
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="FocusVisualPrimaryThickness" Value="0" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="StripSurface" Margin="8,0,8,6" CornerRadius="6"
            Background="{ThemeResource TabStripSurfaceDark}"
            BorderThickness="1" BorderBrush="{ThemeResource TabStripBorderDark}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Disabled"
                      Padding="3,2">
            <ListView x:Name="Tabs"
                      ItemTemplate="{StaticResource TabItemTemplate}"
                      ItemContainerStyle="{StaticResource CompactTabItemStyle}"
                      SelectionMode="Single"
                      SelectionChanged="OnSelectionChanged"
                      AllowDrop="True"
                      DragOver="OnTabsDragOver"
                      DragLeave="OnTabsDragLeave"
                      Drop="OnTabsDrop"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      Background="Transparent"
                      BorderThickness="0">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="3" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
        </ScrollViewer>
    </Border>
</UserControl>
