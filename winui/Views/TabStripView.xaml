<?xml version="1.0" encoding="utf-8"?>
<!--
    TabStripView.xaml —— 标签栏（横向可滚动）

    三种图标形态（设置项 tab_icon_mode）：
      · text   ：只保留文字（与原版 v1.11.6 / QML 一致）
      · always ：常驻图标
      · hover  ：悬停时图标从文字左边浮现，标签随之整体拉伸

    ⚠️ 悬停判定必须做"去抖 + 范围复核"：图标槽变宽会让内容平移，
       WinUI 可能在指针没真的离开时抛 PointerExited，导致拉伸/缩回无限往复
       （用户实测反馈的 bug）。详见 TabStripView.xaml.cs 的注释。
-->
<UserControl
    x:Class="ToolboxPanel.Views.TabStripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ToolboxPanel.ViewModels">

    <UserControl.Resources>
        <!--
            轻量样式覆盖（lightweight styling）：只改颜色、不动模板，
            把标签项的默认选中胶囊与焦点框换成"更亮的底 + 底部强调条"。
            ⚠️ 这些是**深色**的初值；浅色主题下由代码换掉（TabStripView.ApplyTheme），
            否则浅色主题会"白字白底"看不见（WinUI 的轻量样式覆盖键不会自己跟着 RequestedTheme 变）。
        -->
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#29FFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemFocusVisualPrimaryBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemFocusVisualSecondaryBrush" Color="Transparent" />

        <DataTemplate x:Key="TabItemTemplate" x:DataType="vm:TabItemViewModel">
            <!--
                ⚠️ 悬停判定**不在这里做**（本模板上没有 PointerEntered/Moved/Exited）。
                以前是每个标签各自判定，结果：
                  · 移到别的标签时，上一个标签收不回去（各自的退出事件互相打架）；
                  · 图标槽变宽会重排内容，WinUI 在指针没离开时抛假退出，抖动。
                现在改由**标签栏统一判定**（TabStripView 上挂 PointerMoved/Exited，
                用平移后的实际文字范围选"指针在哪个标签上"），保证**同时最多只有一个标签展开**。
            -->
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" Margin="0,0,0,2">
                    <!--
                        「隐藏项」= 图标槽 + 数量文字：两者一起淡出/淡入（用户要求把它们视为同一种隐藏项）。
                        ⚠️ 用**负左边距**做动画而不是改宽度：改宽度会触发布局重排（抖动+卡顿），
                        负边距只影响渲染位置，布局尺寸恒定 ⇒ 既平滑又不会引发假的指针退出事件。
                    -->
                    <Grid x:Name="TabHiddenHost" IsHitTestVisible="False"
                          Loaded="OnHiddenHostLoaded">
                        <Grid.RenderTransform>
                            <CompositeTransform x:Name="HiddenHostTransform" TranslateX="0" />
                        </Grid.RenderTransform>

                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    Margin="-16,0,0,0" VerticalAlignment="Center">
                            <Grid Width="16" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" />
                            </Grid>

                            <!-- 数量文字（设置里可以隐藏）：与图标同一个隐藏项，一起出现/收起 -->
                            <TextBlock x:Name="TabCountText" Text="{x:Bind CountLabel}" FontSize="10" Opacity="0.5"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ShowCount, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="TabNameText" Text="{x:Bind Name}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 选中态：底部 2px 强调条（颜色走主题令牌，见 TabStripView.ApplyTheme） -->
                <Border x:Name="SelectionBar" Height="2" Width="16" CornerRadius="1"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Background="{ThemeResource AccentBrushDark}"
                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="CompactTabItemStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="StripSurface" Margin="8,0,8,6" CornerRadius="6"
            Background="{ThemeResource TabStripSurfaceDark}"
            BorderThickness="1" BorderBrush="{ThemeResource TabStripBorderDark}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Disabled"
                      Padding="3,2">
            <ListView x:Name="Tabs"
                      ItemTemplate="{StaticResource TabItemTemplate}"
                      ItemContainerStyle="{StaticResource CompactTabItemStyle}"
                      SelectionMode="Single"
                      SelectionChanged="OnSelectionChanged"
                      AllowDrop="True"
                      DragOver="OnTabsDragOver"
                      DragLeave="OnTabsDragLeave"
                      Drop="OnTabsDrop"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      Background="Transparent"
                      BorderThickness="0">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="3" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
        </ScrollViewer>
    </Border>
</UserControl>
