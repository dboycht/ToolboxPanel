<?xml version="1.0" encoding="utf-8"?>
<!--
    ListItemEditDialog.xaml —— 列表项的「新建 / 编辑属性…」对话框（照原版 _list_item_dialog）

    字段：说明 + 路径（路径旁带「选择文件 / 选择文件夹」两个按钮）；
    规则：**说明与路径都为空**时窗内报错、不关窗（原版是静默什么都不做）。
    文案与校验都来自 Core 的 `ListItemEditor`（有单测），UI 不另写一份。
-->
<ContentDialog
    x:Class="ToolboxPanel.Views.ListItemEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="确定"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="10" MinWidth="420">
        <TextBox x:Name="DescriptionBox" Header="说明" PlaceholderText="文本说明" />

        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PathBox" Grid.Column="0" Header="路径" />
            <Button x:Name="PickFileButton" Grid.Column="1" Content="选择文件"
                    VerticalAlignment="Bottom" Margin="0,0,0,1" Click="OnPickFileClick" />
            <Button x:Name="PickFolderButton" Grid.Column="2" Content="选择文件夹"
                    VerticalAlignment="Bottom" Margin="0,0,0,1" Click="OnPickFolderClick" />
        </Grid>

        <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
