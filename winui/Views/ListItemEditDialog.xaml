<?xml version="1.0" encoding="utf-8"?>
<!--
    ListItemEditDialog.xaml —— 列表项的「新建 / 编辑属性…」对话框（照原版 _list_item_dialog）

    字段：说明 + 路径（路径旁带「选择文件 / 选择文件夹」两个按钮）；
    规则：**说明与路径都为空**时窗内报错、不关窗（原版是静默什么都不做）。
    文案与校验都来自 Core 的 `ListItemEditor`（有单测），UI 不另写一份。

    ⚠️ 文案（v2.0.3 i18n）：静态标签走 `ui:Tr.Key`；标题与对话框按钮文字在构造函数里设。
-->
<ContentDialog
    x:Class="ToolboxPanel.Views.ListItemEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:ToolboxPanel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="10" MinWidth="420">
        <TextBox x:Name="DescriptionBox" ui:Tr.Header="list.col.desc" ui:Tr.Tip="list.desc_ph" />

        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PathBox" Grid.Column="0" ui:Tr.Header="list.col.path" />
            <Button x:Name="PickFileButton" Grid.Column="1" ui:Tr.Key="list.select_file"
                    VerticalAlignment="Bottom" Margin="0,0,0,1" Click="OnPickFileClick" />
            <Button x:Name="PickFolderButton" Grid.Column="2" ui:Tr.Key="list.select_folder"
                    VerticalAlignment="Bottom" Margin="0,0,0,1" Click="OnPickFolderClick" />
        </Grid>

        <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
