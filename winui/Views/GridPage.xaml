<?xml version="1.0" encoding="utf-8"?>
<!--
    GridPage.xaml —— 网格页（紧凑版：76×84 图块、32px 图标、11 号字两行名）

    ⚠️ WinUI 的 GridView **自己管 delegate 的 x/y**：模板里不要绑 y、不要给 y 加动画
       （同类坑见 memory/05-布局与动效通用坑.md）。

    拖拽排序（W3）：图块容器开 CanDrag，页面上接 DragStarting / DragOver / Drop，
      **不用** GridView 内置的 CanReorderItems（理由见 GridPage.xaml.cs 顶部注释）。
-->
<UserControl
    x:Class="ToolboxPanel.Views.GridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ToolboxPanel.ViewModels">

    <UserControl.Resources>
        <!--
            图块容器：**必须显式给 Width/Height**。
            WinUI 的 GridView 默认用 ItemsWrapGrid，而 ItemsWrapGrid 会把每个 item 撑成
            "可用宽度 / 列数"，于是图标被横向拉开、一屏只放得下少数几列（就是"不紧凑"的根因）。
            给容器定死尺寸后，列数按 容器宽度 自动排（880 宽 ≈ 10 列）。
        -->
        <Style x:Key="CompactTileStyle" TargetType="GridViewItem">
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="72" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <!--
                拖拽排序：容器可拖 ⇒ **按下拖动即起拖**（系统原生行为，像 Windows 桌面）。
                ⚠️ 2026-09-14 用户明确要求取消"长按 350ms 才起拖"那套判定（"只要有拖动的话都算"）。
                ⚠️ 2026-09-15 用户明确要求取消"实时让位"：拖动时只显示插入竖条，
                   图块不乱动，松手才插入。见 GridPage.xaml.cs 顶部注释。
            -->
            <Setter Property="CanDrag" Value="True" />
        </Style>

        <DataTemplate x:Key="IconTileTemplate" x:DataType="vm:IconTileViewModel">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top">

                <!--
                    批量管理的勾选框（仅批量模式可见）。
                    ⚠️ `IsHitTestVisible=False`：**它只作指示**，点击一律由图块自己处理
                       （OnTileClick 在批量模式下切换勾选）—— 这样"点哪里都能勾"，不会出现
                       "点方框有反应、点图标没反应"的不一致。
                -->
                <CheckBox IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                          Visibility="{x:Bind BulkCheckVisibility, Mode=OneWay}"
                          IsHitTestVisible="False"
                          MinWidth="0" Padding="0" Width="20" Height="20"
                          HorizontalAlignment="Left" VerticalAlignment="Top" />

                <StackPanel VerticalAlignment="Top" Spacing="2">

                    <!-- 真图标（data/icons/*.png 缓存） -->
                    <!-- ⚠️ 全部 Mode=OneWay：① 编辑属性之后要能就地刷新；② 换"图标大小"档时要跟着变
                         （x:Bind 默认是 OneTime，不写 OneWay 就永远不变） -->
                    <Image Source="{x:Bind IconSource, Mode=OneWay}"
                           Width="{x:Bind IconPixels, Mode=OneWay}"
                           Height="{x:Bind IconPixels, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind HasIcon, Mode=OneWay}" />

                    <!-- 拿不到图标时的字形兜底 -->
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="{x:Bind GlyphPixels, Mode=OneWay}"
                              HorizontalAlignment="Center"
                              Visibility="{x:Bind HasNoIcon, Mode=OneWay}" />

                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                               FontSize="{x:Bind FontSize, Mode=OneWay}"
                               LineHeight="{x:Bind LineHeight, Mode=OneWay}"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 第 0 行 = 批量管理条（仅批量模式可见）；其余内容都在第 1 行 -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            批量管理条（照原版"批量管理模式"的语义，形态适配我们没有菜单栏的窗口）：
              · 进入方式：网格空白处右键 → 「批量管理」（原版是 "视图/编辑" 菜单里的一项）
              · 条上有：模式提示 + 已选数量 + 全选 + 批量删除勾选图标 + 退出批量管理
              · 退出后自动清空所有勾选（与原版 set_batch_mode(False) 一致）
        -->
        <Border x:Name="BulkBar" Grid.Row="0" Visibility="Collapsed"
                Padding="8,6" CornerRadius="6" Margin="4,3,4,0"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE762;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="BulkTitle" Text="批量管理" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="BulkCount" Text="已选 0 个" FontSize="12" Opacity="0.75"
                           VerticalAlignment="Center" />
                <Button x:Name="BulkSelectAllButton" Content="全选" Padding="8,2" FontSize="12"
                        Click="OnBulkSelectAllClick" />
                <Button x:Name="BulkDeleteButton" Content="批量删除勾选图标" Padding="8,2" FontSize="12"
                        Click="OnBulkDeleteClick" />
                <Button x:Name="BulkExitButton" Content="退出批量管理" Padding="8,2" FontSize="12"
                        Click="OnBulkExitClick" />
            </StackPanel>
        </Border>

        <!--
            右键菜单（照原版 v1.11.6 的交互）：
              · 空白处右键 → 新建文件/文件夹/快捷方式/网址/命令图标
              · 图块上右键 → 编辑属性…
            用 ContextRequested（而不是 RightTapped）：右键与键盘「菜单键 / Shift+F10」都能触发。
            菜单项由托管窗口处理（页面只发事件，不自己开对话框、不碰数据）。
        -->
        <!--
            起拖交给**系统的原生拖拽**：按下拖动即起拖（像 Windows 桌面）—— 用户明确要求取消长按门控。
            （曾经把这里设成 False + 自己用长按定时器起拖，那套已按用户要求删除。）

            ⚠️ **起拖事件在代码里用 `AddHandler(..., handledEventsToo: true)` 挂**（2026-09-16 实测根因）：
               `ListViewBase` 内部会处理并**标记 handled** `DragStarting` / `DragItemsStarting`，
               写在 XAML 上的处理器**一次都收不到** ⇒ 载荷写不进 DataPackage ⇒
               目标端只能拒绝（系统光标显示"禁止"）、既没有插入竖条也不会插入。
        -->
        <GridView x:Name="TileGrid"
                  Grid.Row="1"
                  ItemTemplate="{StaticResource IconTileTemplate}"
                  ItemContainerStyle="{StaticResource CompactTileStyle}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnTileClick"
                  CanDrag="True"
                  CanDragItems="True"
                  AllowDrop="True"
                  DragOver="OnTileDragOver"
                  Drop="OnTileDrop"
                  DragItemsCompleted="OnTileDragItemsCompleted"
                  ContextRequested="OnContextRequested"
                  Padding="4,3"
                  Background="Transparent">

            <!--
                ⚠️ 2026-09-16 用户反馈："插入后图标所有会展示一下重新进入动画"。
                根因：GridView 默认的 ItemContainerTransitions 是
                  [AddDeleteThemeTransition, ContentThemeTransition, ReorderThemeTransition, EntranceThemeTransition]
                —— **拖动时框架会回收/重建被拖项的容器**（程序化改集合不会），
                于是 EntranceThemeTransition（入场）+ ContentThemeTransition（内容变化淡入）会再播一遍，
                观感就是"所有图标重新进入一次"。
                这里**只保留 ReorderThemeTransition**（它只做"位置移动"的过渡，不会淡入），
                应用自己的入场效果由 EntranceAnimator 的"整片淡入"负责，不依赖这些内置过渡。
            -->
            <GridView.ItemContainerTransitions>
                <TransitionCollection>
                    <ReorderThemeTransition />
                </TransitionCollection>
            </GridView.ItemContainerTransitions>
        </GridView>

        <!-- 空页提示（没有图标时显示） -->
        <StackPanel x:Name="EmptyHint"
                    Grid.Row="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="6" Visibility="Collapsed">
            <FontIcon Glyph="&#xE8A5;" FontSize="32" Opacity="0.45" />
            <TextBlock Text="这一页还没有图标" Opacity="0.65" FontSize="12" />
            <TextBlock Text="在空白处点右键新建，或把文件 / 文件夹 / 快捷方式拖进来" Opacity="0.4" FontSize="10.5"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <!--
            拖拽**插入竖条**：绘制在内容之上（放在 Grid 最后）。
            高度 = 目标图块的高度（靠代码设），宽度 3、强调色圆角竖条 ——
            拖动时它出现在"松手会插进去"的那个相邻图块位置上（用户 2026-09-15 定的形态）。

            ⚠️ 必须包在 **Canvas** 里：`Canvas.Left/Top` 只在**父级是 Canvas** 时才生效，
               直接放在 Grid 里会永远停在左上角（本项目 2026-09-15 实测踩过，见 ERROR.md E23）。
            ⚠️ IsHitTestVisible=False：不吃拖放事件，否则 DragOver/Drop 会被它截走。
        -->
        <Canvas x:Name="DropLayer" Grid.Row="1" IsHitTestVisible="False">
            <Border x:Name="DropIndicator"
                    Width="3" CornerRadius="2"
                    Background="{ThemeResource AccentBrushDark}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Canvas>
    </Grid>
</UserControl>

