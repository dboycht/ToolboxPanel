<?xml version="1.0" encoding="utf-8"?>
<!--
    GridPage.xaml —— 网格页（紧凑版：76×84 图块、32px 图标、11 号字两行名）

    ⚠️ WinUI 的 GridView **自己管 delegate 的 x/y**：模板里不要绑 y、不要给 y 加动画
       （同类坑见 memory/05-布局与动效通用坑.md）。
-->
<UserControl
    x:Class="ToolboxPanel.Views.GridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ToolboxPanel.ViewModels">

    <UserControl.Resources>
        <!--
            图块容器：**必须显式给 Width/Height**。
            WinUI 的 GridView 默认用 ItemsWrapGrid，而 ItemsWrapGrid 会把每个 item 撑成
            "可用宽度 / 列数"，于是图标被横向拉开、一屏只放得下少数几列（就是"不紧凑"的根因）。
            给容器定死尺寸后，列数按 容器宽度 自动排（880 宽 ≈ 10 列）。
        -->
        <Style x:Key="CompactTileStyle" TargetType="GridViewItem">
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="72" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <DataTemplate x:Key="IconTileTemplate" x:DataType="vm:IconTileViewModel">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Top" Spacing="2">

                    <!-- 真图标（data/icons/*.png 缓存） -->
                    <Image Source="{x:Bind IconSource}"
                           Width="30" Height="30"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind HasIcon}" />

                    <!-- 拿不到图标时的字形兜底 -->
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="24"
                              HorizontalAlignment="Center"
                              Visibility="{x:Bind HasNoIcon}" />

                    <TextBlock Text="{x:Bind DisplayName}"
                               FontSize="10.5"
                               LineHeight="12.5"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <GridView x:Name="TileGrid"
                  ItemTemplate="{StaticResource IconTileTemplate}"
                  ItemContainerStyle="{StaticResource CompactTileStyle}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnTileClick"
                  Padding="4,3"
                  Background="Transparent" />

        <!-- 空页提示（没有图标时显示） -->
        <StackPanel x:Name="EmptyHint"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="6" Visibility="Collapsed">
            <FontIcon Glyph="&#xE8A5;" FontSize="32" Opacity="0.45" />
            <TextBlock Text="这一页还没有图标" Opacity="0.65" FontSize="12" />
            <TextBlock Text="（新建 / 拖入图标在 W5 实现）" Opacity="0.4" FontSize="10.5" />
        </StackPanel>
    </Grid>
</UserControl>
