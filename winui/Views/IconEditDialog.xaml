<?xml version="1.0" encoding="utf-8"?>
<!--
    IconEditDialog.xaml —— 「新建 / 编辑图标」的字段对话框（照原版 v1.11.6 icon_edit_dialog.py）

    字段随类型变化（与原版一一对应）：
      文件 / 文件夹 : 名称 + 路径
      快捷方式      : 名称 + 路径(目标) + 参数 + 工作目录 + 描述 + 自定义图标(文件 + 索引)
      网址          : 名称 + 网址
      命令          : 名称 + 命令 + 参数 + 工作目录

    ⚠️ 校验在 Core（IconEditor.ValidateCreate / ValidateEdit）：
       点「确定」不通过时**不关对话框**，把消息显示在 ErrorText。
       （原版是关掉窗口后把错误写进状态栏，用户得再开一次 —— 这里体验更好，逻辑不变。）
-->
<ContentDialog
    x:Class="ToolboxPanel.Views.IconEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="确定"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <Grid Width="440" ColumnSpacing="10" RowSpacing="9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="64" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0 类型提示 -->
            <RowDefinition Height="Auto" />   <!-- 1 名称 -->
            <RowDefinition Height="Auto" />   <!-- 2 主字段 -->
            <RowDefinition Height="Auto" />   <!-- 3 参数 -->
            <RowDefinition Height="Auto" />   <!-- 4 工作目录 -->
            <RowDefinition Height="Auto" />   <!-- 5 描述 -->
            <RowDefinition Height="Auto" />   <!-- 6 自定义图标 -->
            <RowDefinition Height="Auto" />   <!-- 7 错误提示 -->
        </Grid.RowDefinitions>

        <!-- 0 类型提示（灰字小号：说明这是「属性编辑」，不是换图标图片） -->
        <TextBlock x:Name="TypeHint" Grid.Row="0" Grid.ColumnSpan="2"
                   Opacity="0.55" FontSize="11" />

        <!-- 1 名称（所有类型通用，必填） -->
        <TextBlock Grid.Row="1" Text="名称:" VerticalAlignment="Center" />
        <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" />

        <!-- 2 主字段：路径 / 命令 / 网址（标签随类型变；网址没有浏览按钮） -->
        <TextBlock x:Name="MainLabel" Grid.Row="2" VerticalAlignment="Center" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="MainBox" VerticalAlignment="Center" MinWidth="280" />
            <Button x:Name="BrowseMainButton" Content="…" Padding="8,4"
                    VerticalAlignment="Center" Click="OnBrowseMainClick"
                    ToolTipService.ToolTip="浏览…" />
        </StackPanel>

        <!-- 3 参数（快捷方式 / 命令） -->
        <TextBlock x:Name="ArgsLabel" Grid.Row="3" Text="参数:" VerticalAlignment="Center" />
        <TextBox x:Name="ArgsBox" Grid.Row="3" Grid.Column="1"
                 PlaceholderText="--verbose backup.py" />

        <!-- 4 工作目录（快捷方式 / 命令） -->
        <TextBlock x:Name="WdLabel" Grid.Row="4" Text="工作目录:" VerticalAlignment="Center" />
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="WdBox" VerticalAlignment="Center" MinWidth="280" />
            <Button x:Name="BrowseWdButton" Content="…" Padding="8,4"
                    VerticalAlignment="Center" Click="OnBrowseWdClick"
                    ToolTipService.ToolTip="浏览…" />
        </StackPanel>

        <!-- 5 描述（仅快捷方式） -->
        <TextBlock x:Name="DescLabel" Grid.Row="5" Text="描述:" VerticalAlignment="Center" />
        <TextBox x:Name="DescBox" Grid.Row="5" Grid.Column="1"
                 PlaceholderText="快捷方式说明（可选）" />

        <!-- 6 自定义图标（仅快捷方式）：文件 + 索引 + 重置 -->
        <TextBlock x:Name="IconLabel" Grid.Row="6" Text="图标:" VerticalAlignment="Center" />
        <StackPanel x:Name="IconRowPanel" Grid.Row="6" Grid.Column="1"
                    Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="IconPathBox" VerticalAlignment="Center" MinWidth="150"
                     PlaceholderText="自定义图标文件（可选）" />
            <Button x:Name="BrowseIconButton" Content="…" Padding="8,4"
                    VerticalAlignment="Center" Click="OnBrowseIconClick"
                    ToolTipService.ToolTip="浏览…" />
            <TextBlock Text="索引:" VerticalAlignment="Center" Opacity="0.6" />
            <NumberBox x:Name="IndexBox" Width="76" Minimum="0" Maximum="999"
                       SpinButtonPlacementMode="Compact" Value="0"
                       VerticalAlignment="Center" />
            <Button x:Name="ResetIconButton" Content="使用默认" Padding="8,4"
                    VerticalAlignment="Center" Click="OnResetIconClick"
                    ToolTipService.ToolTip="恢复使用目标程序的默认图标" />
        </StackPanel>

        <!-- 7 错误提示（校验不过时显示，平时收起） -->
        <TextBlock x:Name="ErrorText" Grid.Row="7" Grid.ColumnSpan="2"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   FontSize="11" Visibility="Collapsed" TextWrapping="Wrap" />
    </Grid>
</ContentDialog>
