<?xml version="1.0" encoding="utf-8"?>
<!--
    ListViewPage.xaml —— 列表页（紧凑版：行高 26、11~12 号字、两列）

    对应 v1.11.6 的 ListTabPage：两列（说明 / 路径），点一行打开该路径。
    行内编辑、右键菜单属于 W5；拖拽排序（同页 + 跨页）已在 W3 做完。

    拖拽：与网格页同一套做法（见 GridPage.xaml.cs 顶部注释的取舍说明）——
      行容器开 CanDrag，页面上接 DragStarting / DragOver / Drop，落点判定交给 Core。
-->
<UserControl
    x:Class="ToolboxPanel.Views.ListViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ToolboxPanel.ViewModels">

    <UserControl.Resources>
        <Style x:Key="CompactRowStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <!--
                拖拽排序：行容器可拖 ⇒ **按下拖动即起拖**（系统原生行为）。
                ⚠️ 2026-09-14 用户明确要求取消长按门控。
                ⚠️ 2026-09-15 用户明确要求取消"实时让位"：拖动时只显示插入横条，行不乱动。
            -->
            <Setter Property="CanDrag" Value="True" />
        </Style>

        <DataTemplate x:Key="ListRowTemplate" x:DataType="vm:ListRowViewModel">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{x:Bind Description}"
                           FontSize="12" TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1" Text="{x:Bind Path}"
                           FontSize="11" Opacity="0.6"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- 起拖交给系统原生拖拽（按下拖动即起拖，同网格页）。
             ⚠️ 起拖事件在代码里用 `AddHandler(..., handledEventsToo: true)` 挂：
                `ListViewBase` 内部会处理并标记 handled `DragStarting` / `DragItemsStarting`，
                XAML 上的处理器一次都收不到 ⇒ 载荷写不进 ⇒ 目标端拒绝（2026-09-16 实测根因）。 -->
        <ListView x:Name="Rows"
                  ItemTemplate="{StaticResource ListRowTemplate}"
                  ItemContainerStyle="{StaticResource CompactRowStyle}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnRowClick"
                  CanDrag="True"
                  CanDragItems="True"
                  AllowDrop="True"
                  DragOver="OnRowDragOver"
                  Drop="OnRowDrop"
                  DragItemsCompleted="OnRowDragItemsCompleted"
                  Padding="6,4"
                  Background="Transparent">

            <!--
                ⚠️ 同网格页：默认的 ItemContainerTransitions 带 EntranceThemeTransition /
                ContentThemeTransition，拖动重排时框架重建容器会把它们再播一遍
                （观感 = "所有项重新进入一次"）。只保留 ReorderThemeTransition（只做位移过渡）。
            -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <ReorderThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
        </ListView>

        <StackPanel x:Name="EmptyHint"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="6" Visibility="Collapsed">
            <FontIcon Glyph="&#xE8FD;" FontSize="32" Opacity="0.45" />
            <TextBlock Text="这一页还没有列表项" Opacity="0.65" FontSize="12" />
            <TextBlock Text="（新建 / 编辑在 W5 实现）" Opacity="0.4" FontSize="10.5" />
        </StackPanel>

        <!--
            拖拽**插入横条**（列表是单列，插入位在行的上/下边缘）：绘制在内容之上。
            ⚠️ 必须包在 **Canvas** 里：`Canvas.Left/Top` 只在**父级是 Canvas** 时才生效，
               直接放在 Grid 里会永远停在左上角（见 ERROR.md E23）。
            ⚠️ IsHitTestVisible=False 保证它不吃拖放事件。
        -->
        <Canvas x:Name="DropLayer" IsHitTestVisible="False">
            <Border x:Name="DropIndicator"
                    Height="3" CornerRadius="2"
                    Background="{ThemeResource AccentBrushDark}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Canvas>
    </Grid>
</UserControl>
