<?xml version="1.0" encoding="utf-8"?>
<!--
    ListViewPage.xaml —— 列表页（紧凑版：行高 26、11~12 号字、两列）

    对应 v1.11.6 的 ListTabPage：两列（说明 / 路径），点一行打开该路径。
    行内编辑、右键菜单属于 W5；拖拽排序（同页 + 跨页）已在 W3 做完。

    拖拽：与网格页同一套做法（见 GridPage.xaml.cs 顶部注释的取舍说明）——
      行容器开 CanDrag，页面上接 DragStarting / DragOver / Drop，落点判定交给 Core。
-->
<UserControl
    x:Class="ToolboxPanel.Views.ListViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ToolboxPanel.ViewModels">

    <UserControl.Resources>
        <Style x:Key="CompactRowStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <!--
                拖拽排序（2026-09-14 与网格页同步改为**长按起拖**，手机桌面手感）：
                不再让系统"按下 + 轻微移动"就起拖 —— 那会与"点一下打开"抢手势。
                这里关掉容器自身的 CanDrag，由页面在长按 350ms 后临时打开并调 StartDragAsync；
                判定逻辑在 Core 的 LongPressGesture（有单测），见 ListViewPage.xaml.cs。
            -->
            <Setter Property="CanDrag" Value="False" />
        </Style>

        <DataTemplate x:Key="ListRowTemplate" x:DataType="vm:ListRowViewModel">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{x:Bind Description}"
                           FontSize="12" TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1" Text="{x:Bind Path}"
                           FontSize="11" Opacity="0.6"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ListView x:Name="Rows"
                  ItemTemplate="{StaticResource ListRowTemplate}"
                  ItemContainerStyle="{StaticResource CompactRowStyle}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnRowClick"
                  CanDrag="True"
                  AllowDrop="True"
                  DragStarting="OnRowDragStarting"
                  DragOver="OnRowDragOver"
                  Drop="OnRowDrop"
                  DragItemsCompleted="OnRowDragItemsCompleted"
                  Padding="6,4"
                  Background="Transparent" />

        <StackPanel x:Name="EmptyHint"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="6" Visibility="Collapsed">
            <FontIcon Glyph="&#xE8FD;" FontSize="32" Opacity="0.45" />
            <TextBlock Text="这一页还没有列表项" Opacity="0.65" FontSize="12" />
            <TextBlock Text="（新建 / 编辑在 W5 实现）" Opacity="0.4" FontSize="10.5" />
        </StackPanel>

        <!--
            拖拽落点指示线：**横**线（列表是单列，插入位在行的上/下边缘）。
            放在最后 = 绘制在内容之上；IsHitTestVisible=False 保证它不吃拖放事件。
        -->
        <Border x:Name="DropIndicator"
                Height="2" CornerRadius="1"
                Background="{ThemeResource AccentBrushDark}"
                IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Collapsed" />
    </Grid>
</UserControl>
