<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ToolboxPanel v2 · WinUI 3 最小验证样板（P0）

    目的只有一个：在真机上确认
      1) 工具链能编译出 WinUI 3 应用（本机只有 VS 生成工具 + .NET 9 SDK）
      2) Mica / Acrylic / DesktopAcrylic 三种系统材质真的能显示
      3) 能读取现有 data/tabs.json（v1 格式）并列出标签页
    验证通过后再铺开写完整 UI。

    ⚠️ 用 **unpackaged**（非 MSIX 打包）模式：直接 dotnet run / 双击 exe 即可，
       不需要证书与 MSIX 安装，最小验证阶段最省事。
       代价：需要目标机器有 Windows App SDK 运行时；本项目用
       WindowsAppSDKSelfContained=true 把运行时随输出一起带上，避免这个依赖。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ToolboxPanel</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      版本号（2.0.1 定版时补上；tag=2.0.1 后的下一轮开发自动升为 2.0.2）。
      ⚠️ 必须与 Python 侧的 `src/toolbox/__init__.py::__version__` **保持一致** ——
      两处各自是本实现的"版本号单一来源"（关于对话框 / EXE 文件属性 / 发布包命名都读它）。
    -->
    <Version>2.0.2</Version>
    <AssemblyVersion>2.0.2.0</AssemblyVersion>
    <FileVersion>2.0.2.0</FileVersion>
    <Product>ToolboxPanel</Product>
    <AssemblyTitle>ToolboxPanel</AssemblyTitle>
    <Company>dboycht</Company>
    <Copyright>Copyright © 2026 dboycht</Copyright>

    <!--
      ⚠️ 必须关掉"把 git 提交号拼进版本信息"的行为，否则上面写的版本会被覆盖成
      `1.0.0+<commit>`（实测：EXE 属性里显示 FileVersion=1.0.0.0、ProductVersion=1.0.0+2903c73…）。
      `IncludeSourceRevisionInInformationalVersion` 是 .NET 8+ 的开关；
      `ContinuousIntegrationBuild=false` 再兜一层（它会关掉 SourceLink）。
      发布包里的版本号必须是我们声明的那个。
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>

    <!-- unpackaged 部署 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <EnableMsixTooling>false</EnableMsixTooling>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2.4.0 是当前稳定版；SystemBackdropElement 自 2.0.1 起 GA -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- W1 的 C# 数据层（纯 .NET 类库，无 UI 依赖，可单测） -->
    <ProjectReference Include="..\core\ToolboxPanel.Core.csproj" />
  </ItemGroup>

</Project>
