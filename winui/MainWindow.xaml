<?xml version="1.0" encoding="utf-8"?>
<!--
    MainWindow.xaml —— W3 主界面（紧凑版）

    结构：自绘标题栏（拖动区） / 标签栏 / 内容区（网格页或列表页） / 状态栏
    密度（2026-09-12 按用户"不够紧凑"的反馈收紧过一次，单位 px）：
      标题栏 34 · 标签栏项 26 高 / 图块 76×84 · 状态栏单项 10.5 号字单行 · 外围留白 8

    ⚠️ 两条玻璃纪律（见 memory/01-玻璃与窗口材质.md）：
      · 根 Grid 必须 Transparent，**任何高不透明度深色底都会把系统材质盖住**；
      · 材质不生效时才由代码补纯色兜底。
    ⚠️ 拖动用 WinUI 原生的 `Window.SetTitleBar(AppTitleBar)` + 系统标题栏按钮（保住缩放/贴边/圆角）。
-->
<Window
    x:Class="ToolboxPanel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ToolboxPanel.ViewModels">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <!-- 标签栏项：图标 + 名称 + 数量，尽量矮 -->
            <DataTemplate x:Key="TabStripItemTemplate" x:DataType="vm:TabItemViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" />
                    <TextBlock Text="{x:Bind Name}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Summary}" FontSize="10" Opacity="0.5" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>

            <!-- 紧凑的标签项容器（去掉 WinUI 默认的大内边距） -->
            <Style x:Key="CompactTabItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="9,3" />
                <Setter Property="Margin" Value="0,0,3,0" />
                <Setter Property="CornerRadius" Value="5" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ① 自绘标题栏（代码里设为拖动区；系统按钮仍在右上角） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="7"
                        Margin="12,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE71D;" FontSize="12" />
                <TextBlock Text="ToolboxPanel" FontSize="12" FontWeight="SemiBold" />
                <TextBlock x:Name="BackdropLabel" FontSize="10.5" Opacity="0.5" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ② 标签栏（矮、横向可滚动） -->
        <Border Grid.Row="1" Margin="8,0,8,6" CornerRadius="6"
                Background="#14FFFFFF" BorderThickness="1" BorderBrush="#1AFFFFFF">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled"
                          Padding="3,2">
                <ListView x:Name="TabStrip"
                          ItemTemplate="{StaticResource TabStripItemTemplate}"
                          ItemContainerStyle="{StaticResource CompactTabItemStyle}"
                          SelectionMode="Single"
                          SelectionChanged="OnTabSelectionChanged"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          Background="Transparent"
                          BorderThickness="0">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="3" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </ScrollViewer>
        </Border>

        <!-- ③ 内容区：网格页 / 列表页在这里切换 -->
        <ContentControl x:Name="ContentHost" Grid.Row="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <!-- ④ 状态栏（单行、矮） -->
        <Border Grid.Row="3" Margin="8,5,8,8" Padding="8,4"
                CornerRadius="5" Background="#26000000">
            <TextBlock x:Name="StatusText" FontSize="10.5"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Text="正在载入…" />
        </Border>
    </Grid>
</Window>
