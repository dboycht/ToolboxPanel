<?xml version="1.0" encoding="utf-8"?>
<!--
    MainWindow.xaml —— 主窗口（编排层，尽量薄）

    结构：自绘标题栏 / 标签栏 / 内容区 / 状态栏 / 设置面板遮罩
      · 标签栏的交互与三种图标形态在 `Views/TabStripView.xaml`
      · 设置项与分节在 `Views/SettingsPanel.xaml`
      · 页面入场动效在 `Views/EntranceAnimator.cs`
    主窗口只负责：窗口 chrome、玻璃材质、装配、以及"把设置套用到界面"。

    ⚠️ 玻璃纪律（见 memory/01-玻璃与窗口材质.md）：根 Grid 必须 Transparent，
       **任何高不透明度深色底都会把系统材质盖住**；只有"材质不生效"时才由代码补纯色兜底。
    ⚠️ 拖动用 WinUI 原生的 `Window.SetTitleBar(AppTitleBar)` + 系统标题栏按钮（保住缩放/贴边/圆角）。
-->
<Window
    x:Class="ToolboxPanel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ToolboxPanel.Views">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ① 自绘标题栏（代码里设为拖动区；系统按钮仍在右上角） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="7"
                        Margin="12,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE71D;" FontSize="12" />
                <TextBlock Text="ToolboxPanel" FontSize="12" FontWeight="SemiBold" />
                <TextBlock x:Name="BackdropLabel" FontSize="10.5" Opacity="0.5" VerticalAlignment="Center" />
                <Button x:Name="SettingsButton" Padding="6,2" Margin="2,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        Click="OnSettingsButtonClick" ToolTipService.ToolTip="设置">
                    <FontIcon Glyph="&#xE713;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ② 标签栏 -->
        <views:TabStripView x:Name="TabStrip" Grid.Row="1" />

        <!-- ③ 内容区：网格页 / 列表页在这里切换 -->
        <ContentControl x:Name="ContentHost" Grid.Row="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <!-- ④ 状态栏（单行、矮） -->
        <Border Grid.Row="3" Margin="8,5,8,8" Padding="8,4"
                CornerRadius="5" Background="#26000000">
            <TextBlock x:Name="StatusText" FontSize="10.5"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Text="正在载入…" />
        </Border>

        <!-- ⑤ 设置面板（单独面板，右侧滑出；有滑入/滑出动画） -->
        <Grid x:Name="SettingsOverlay" Grid.RowSpan="4" Visibility="Collapsed" Canvas.ZIndex="10">
            <!-- 点空白处关闭：这层在面板"下面"，点面板本身不会命中它 -->
            <Grid x:Name="SettingsBackdrop" Background="#59000000" Tapped="OnSettingsBackdropTapped" />

            <Border x:Name="SettingsPanelHost" Width="392"
                    HorizontalAlignment="Right" Background="#F21B1B1F"
                    BorderThickness="1,0,0,0" BorderBrush="#1FFFFFFF">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="SettingsPanelTransform" TranslateX="392" />
                </Border.RenderTransform>
                <views:SettingsPanel x:Name="Settings" />
            </Border>
        </Grid>
    </Grid>
</Window>
