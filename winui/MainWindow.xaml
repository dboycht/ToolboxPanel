<?xml version="1.0" encoding="utf-8"?>
<!--
    MainWindow.xaml —— 主窗口（编排层，尽量薄）

    结构：自绘标题栏 / 标签栏 / 内容区 / 状态栏 / 设置面板遮罩
      · 标签栏的交互与三种图标形态在 `Views/TabStripView.xaml`
      · 设置项与分节在 `Views/SettingsPanel.xaml`
      · 页面入场动效在 `Views/EntranceAnimator.cs`
    主窗口只负责：窗口 chrome、玻璃材质、装配、以及"把设置套用到界面"。

    ⚠️ 玻璃纪律（见 memory/01-玻璃与窗口材质.md）：根 Grid 必须 Transparent，
       **任何高不透明度深色底都会把系统材质盖住**；只有"材质不生效"时才由代码补纯色兜底。
    ⚠️ 拖动用 WinUI 原生的 `Window.SetTitleBar(AppTitleBar)` + 系统标题栏按钮（保住缩放/贴边/圆角）。
-->
<Window
    x:Class="ToolboxPanel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:ToolboxPanel"
    xmlns:views="using:ToolboxPanel.Views">

    <Grid x:Name="RootGrid" Background="Transparent">
        <!--
            ⚠️ 快捷键**不在这里手写**：加速器由 `MainWindow.ApplyShortcuts()` 照着
            Core 的 `ShortcutCatalog` 逐个注册（有单测钉住"键位不重复、功能名 key 都在"）。
            手写一份 XAML 列表的坏处是"加了功能忘了接线 / 改了键位只改一处"——
            本项目已被这类漂移咬过（标签栏右键菜单、`AddTab` 长期没有入口）。
        -->

        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="Auto" />
            <!-- 搜索栏（默认隐藏；🔍 / Ctrl+F 切换） -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ① 自绘标题栏（代码里设为拖动区；系统按钮仍在右上角） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="7"
                        Margin="12,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE71D;" FontSize="12" />
                <TextBlock x:Name="TitleText" Text="ToolboxPanel" FontSize="12" FontWeight="SemiBold" />
                <TextBlock x:Name="BackdropLabel" FontSize="10.5" Opacity="0.5" VerticalAlignment="Center" />
                <!--
                    ⚠️ 设置按钮**必须关掉焦点视觉 + 不进 Tab 序列**（用户实测反馈："启动时这个按钮是选中状态"）。
                    根因：它是窗口树里第一个可获焦的控件，窗口激活时 WinUI 会自动把焦点给它，
                    于是默认的焦点框/焦点底就被画出来了 —— 看起来像"被选中"。
                    · `IsTabStop=False` + `UseSystemFocusVisuals=False` + 两处 FocusVisual*Thickness=0 一起关掉；
                    · 键盘可达性**不受影响**：Esc 关面板由 SettingsPanel 自己的 KeyboardAccelerator 负责。
                    （同一套修法在本工作区 learn-helper 项目里已用过 → 跨项目通用经验，见 memory/03。）
                -->
                <Button x:Name="SettingsButton" Padding="6,2" Margin="2,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        IsTabStop="False"
                        UseSystemFocusVisuals="False"
                        FocusVisualPrimaryThickness="0"
                        FocusVisualSecondaryThickness="0"
                        Click="OnSettingsButtonClick" ui:Tr.Tip="titlebar.settings">
                    <FontIcon Glyph="&#xE713;" FontSize="12" />
                </Button>
                <!--
                    「关于」按钮：与设置按钮同一套写法（同一套 E15 纪律：
                    关掉焦点视觉 + 不进 Tab 序列，避免启动时被系统焦点画出框）。
                -->
                <Button x:Name="AboutButton" Padding="6,2" Margin="2,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        IsTabStop="False"
                        UseSystemFocusVisuals="False"
                        FocusVisualPrimaryThickness="0"
                        FocusVisualSecondaryThickness="0"
                        Click="OnAboutButtonClick" ui:Tr.Tip="titlebar.about">
                    <FontIcon Glyph="&#xE946;" FontSize="12" />
                </Button>
                <!--
                    「快捷键参考」按钮：原版在**帮助菜单**里；本实现没有菜单栏，
                    所以按"标题栏按钮 = 原来菜单项"的既有做法放在「关于」旁边（同一套 E15 纪律）。
                -->
                <Button x:Name="ShortcutButton" Padding="6,2" Margin="2,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        IsTabStop="False"
                        UseSystemFocusVisuals="False"
                        FocusVisualPrimaryThickness="0"
                        FocusVisualSecondaryThickness="0"
                        Click="OnShortcutButtonClick" ui:Tr.Tip="shortcut.dialog.title">
                    <FontIcon Glyph="&#xE897;" FontSize="12" />
                </Button>
                <!--
                    搜索按钮：与设置/关于同一套写法（同一套 E15 纪律：关掉焦点视觉）。
                    行为照原版 v1.11.6：**隐藏式搜索栏**，点一下开、再点一下关（Ctrl+F 同效）。
                -->
                <Button x:Name="SearchButton" Padding="6,2" Margin="2,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        IsTabStop="False"
                        UseSystemFocusVisuals="False"
                        FocusVisualPrimaryThickness="0"
                        FocusVisualSecondaryThickness="0"
                        Click="OnSearchButtonClick" ui:Tr.Tip="search.tip">
                    <FontIcon Glyph="&#xE721;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ② 标签栏 -->
        <views:TabStripView x:Name="TabStrip" Grid.Row="1" />

        <!--
            ②' 搜索栏（默认隐藏；🔍 按钮 / Ctrl+F 切换，Esc 关闭）
              · 查询是**全局一个**：过滤"当前显示的那一页"，切页后继续生效；
              · 关闭搜索栏 = 清空查询（否则会出现"看不见的过滤"，页面莫名其妙少一半图标）；
              · 底色用框架主题资源（与批量条同一套），不写死颜色 —— 浅深色自动跟。
        -->
        <!--
            🔍 搜索栏的**宿主**：搜索栏在 Auto 行、内容区在下面的 `*` 行 ⇒ 一显示就会把内容区往下挤。
            所以"弹出动画"要动的是**宿主的高度**（让内容跟着平滑下移），而不只是淡入。

            ⚠️ 为什么外面还要套一层（而不是直接动画 `SearchBar.Height`）：
            ① `SearchBar` 自己带 `Margin="8,2,8,4"` —— 高度归 0 时这 6px 外边距**还在**，
               行高收不干净（会留一条缝）。宿主本身无外边距 ⇒ 归 0 就是真的 0；
            ② 宿主带 `Clip`（见 `OnSearchHostSizeChanged`）：高度动画过程中内容会被裁掉，
               不会把图标/文字"挤"到外面去（XAML 默认**不**裁剪子元素）。
        -->
        <Grid x:Name="SearchHost" Grid.Row="2" Visibility="Collapsed"
              SizeChanged="OnSearchHostSizeChanged">
            <Border x:Name="SearchBar"
                    Margin="8,2,8,4" Padding="10,4" CornerRadius="6"
                    BorderThickness="1" BorderBrush="Transparent"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <!--
                ⚠️ 干掉内层 TextBox 自带的装饰（2026-09-19 按用户截图修"不对称"）：

                用户截图实测：容器底宽 246px，而那条**蓝线**从 x=53 才开始（左侧图标那 44px 没有线）、
                一直顶到容器右缘，而且浮在容器底上方 4px —— 看着就是"线只在文字下面、左右不等"。

                根因：那条线是 **TextBox 模板自己画的聚焦下划线**（模板里 `BorderElement` 的
                `BorderThickness` 在 Focused 状态下被轻量样式键 `TextControlBorderThemeThicknessFocused`
                覆盖成 `0,0,0,2`）—— **光在控件上写 `BorderThickness="0"` 不生效**（状态动画会盖掉它），
                所以必须把**那几个键**在本作用域里改成 0 / 透明。

                修法（"同一份外观只能有一个来源"，与 memory/07 的换主题纪律同一条）：
                · 内层 TextBox 只留文字，**不画任何边框/底色/下划线**；
                · 聚焦提示改由**外层容器**承担（1px 描边 + GotFocus/LostFocus 换色）
                  —— 容器是整块圆角，天然左右对称。
            -->
            <Border.Resources>
                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                <Thickness x:Key="TextControlBorderThemeThicknessPointerOver">0</Thickness>
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            </Border.Resources>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="12" VerticalAlignment="Center" />

                <!--
                    `Padding="0"` + `MinHeight="0"`：让文字区的高度与左右间距都由**容器**的
                    `Padding="10,4"` 与 `ColumnSpacing="8"` 决定 —— 内层不再有自己的
                    内边距与最小高度（TextBox 模板默认 MinHeight=32，会让这个 12px 字的搜索条显得很"高"）。
                -->
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                         FontSize="12" VerticalAlignment="Center"
                         ui:Tr.Key="search.placeholder"
                         TextChanged="OnSearchTextChanged"
                         KeyDown="OnSearchBoxKeyDown"
                         GotFocus="OnSearchBoxGotFocus"
                         LostFocus="OnSearchBoxLostFocus" />

                <TextBlock x:Name="SearchCount" Grid.Column="2" FontSize="11" Opacity="0.7"
                           VerticalAlignment="Center" />

                <Button x:Name="SearchCloseButton" Grid.Column="3" Padding="6,2"
                        Background="Transparent" BorderThickness="0"
                        IsTabStop="False"
                        UseSystemFocusVisuals="False"
                        FocusVisualPrimaryThickness="0"
                        FocusVisualSecondaryThickness="0"
                        Click="OnSearchCloseClick" ui:Tr.Tip="search.close_tip">
                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                </Button>
            </Grid>
            </Border>
        </Grid>

        <!--
            ③ 内容区：网格页 / 列表页在这里切换。

            ⚠️ 这里**故意用 ContentControl + 常驻页面**，而不是"换一次页就替换 Content**：
            · 页面一旦被换出，它的 item 容器会被**回收销毁**（探针实测：切回时"已实现=0"），
              再切回来时容器是"重新实现"的 —— 重新实现发生在渲染之后，于是那一帧会以最终态闪一下，
              用户看到的就是"先亮一下、再重播"（这就是反复反馈的"不像从无到有"）。
            · 现在做法：每个页面建一次、**常驻**在这个 Grid 里，切页只切 `Visibility`；
              **首次**展示（容器还没实现）时页面级不透明度=0 兜住，
              之后容器不再被销毁，入场动效必然是"从无到有"。
        -->
        <Grid x:Name="PageHost" Grid.Row="3" Background="Transparent" />

        <!-- ④ 状态栏（单行、矮）——底色/描边全部走主题令牌 -->
        <Border x:Name="StatusBar" Grid.Row="4" Margin="8,5,8,8" Padding="8,4"
                CornerRadius="5" Background="{ThemeResource StatusSurfaceDark}">
            <TextBlock x:Name="StatusText" FontSize="10.5"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       ui:Tr.Key="status.loading" />
        </Border>

        <!-- ⑤ 设置面板（单独面板，右侧滑出；有滑入/滑出动画） -->
        <Grid x:Name="SettingsOverlay" Grid.RowSpan="5" Visibility="Collapsed" Canvas.ZIndex="10">
            <!-- 点空白处关闭：这层在面板"下面"，点面板本身不会命中它 -->
            <Grid x:Name="SettingsBackdrop" Background="{ThemeResource OverlaySurfaceDark}"
                  Tapped="OnSettingsBackdropTapped" />

            <!--
                ⚠️ 面板底色**不能写死**（原来是 #F21B1B1F 的近实心黑）：
                那既盖住了窗口材质（玻璃观感没了），也不跟随主题。
                现在交给主题：XAML 只给深色兜底，真正的画刷由 MainWindow.ApplyTheme 按当前令牌换
                （浅色/深色各一套；面板表面用元素级 Acrylic 保住可读性）。
            -->
            <Border x:Name="SettingsPanelHost" Width="392"
                    HorizontalAlignment="Right" Background="{ThemeResource PanelSurfaceDark}"
                    BorderThickness="1,0,0,0" BorderBrush="{ThemeResource PanelBorderDark}">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="SettingsPanelTransform" TranslateX="392" />
                </Border.RenderTransform>
                <views:SettingsPanel x:Name="Settings" />
            </Border>
        </Grid>
    </Grid>
</Window>
