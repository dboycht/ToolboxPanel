<?xml version="1.0" encoding="utf-8"?>
<!--
    MainWindow.xaml —— ToolboxPanel v2 · WinUI 3 最小验证样板（W0）

    这个窗口只有一个目的：让用户在真机上目检三件事
      ① Mica / Acrylic 窗口材质是否可见（切换按钮在第二行）；
      ② 元素级 Acrylic 是否真的糊住了它下面的「应用内」内容（右侧彩色块上的卡片）；
      ③ 能否读出现有 data/tabs.json（v1 格式）并列出标签页（左侧列表）。

    ⚠️ 玻璃观感的关键：根 Grid 必须是 Background="Transparent"，
       任何一层不透明的深色底都会把系统材质整个盖住（见 ERROR.md E9）。
       本样板刻意不在根上铺任何底色 —— 由代码在「材质不受支持」时才补纯色兜底。
-->
<Window
    x:Class="ToolboxPanel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ToolboxPanel">

    <Grid x:Name="RootGrid" Background="Transparent">
        <!--
            ⚠️ WinUI 3 的 Window **不是** FrameworkElement，没有 Window.Resources；
               资源必须挂在根 Grid（或 App.xaml）上。第一次编译就撞到这里。
        -->
        <Grid.Resources>
            <!-- 标签页行模板 -->
            <DataTemplate x:Key="TabRowTemplate" x:DataType="local:TabRow">
            <Grid Padding="2,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="16" Height="16" CornerRadius="4"
                        VerticalAlignment="Center"
                        Background="{x:Bind Accent}" />

                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{x:Bind Summary}" FontSize="11" Opacity="0.75"
                               TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{x:Bind Kind}" FontSize="11"
                           Opacity="0.8" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ① 自绘标题栏（代码里 SetTitleBar 把它设为拖动区） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8"
                        Margin="16,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE71D;" FontSize="13" />
                <TextBlock Text="ToolboxPanel · WinUI 3 样板（W0 验证）" FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- ② 窗口材质切换 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="16,6,16,10">
            <TextBlock Text="窗口材质：" FontSize="12" VerticalAlignment="Center" />
            <Button Content="纯色回退" Tag="none" Click="OnBackdropClick" />
            <Button Content="Mica" Tag="mica" Click="OnBackdropClick" />
            <Button Content="Mica Alt" Tag="micaAlt" Click="OnBackdropClick" />
            <Button Content="Desktop Acrylic" Tag="acrylic" Click="OnBackdropClick" />
            <Button Content="Acrylic Thin" Tag="acrylicThin" Click="OnBackdropClick" />
        </StackPanel>

        <!-- ③ 两块验证内容 -->
        <Grid Grid.Row="2" Margin="16,0,16,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：读旧数据 -->
            <Grid Grid.Column="0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontWeight="SemiBold" FontSize="13"
                           Text="① 读取现有 data/tabs.json（v1 旧数据）" />

                <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                        BorderBrush="#33FFFFFF" Background="#22000000">
                    <ListView x:Name="TabList"
                              ItemTemplate="{StaticResource TabRowTemplate}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="6,2" />
                </Border>
            </Grid>

            <!-- 右：元素级 Acrylic（B 层：糊住应用内内容） -->
            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontWeight="SemiBold" FontSize="13"
                           Text="② 元素级 Acrylic（糊住它下面的应用内内容）" />

                <Border Grid.Row="1" CornerRadius="8">
                    <Grid>
                        <!-- 底层：大块高饱和色块（比细字更容易看出"糊没糊"）+ 条纹文字 -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF0B6E4F" Offset="0" />
                                    <GradientStop Color="#FF3FA7D6" Offset="0.5" />
                                    <GradientStop Color="#FFE8A33D" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Ellipse Width="190" Height="190" Fill="#FFFF4D6D"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="-30,-30,0,0" />
                        <Ellipse Width="210" Height="210" Fill="#FF2D6BFF"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,-30,-30" />
                        <Ellipse Width="130" Height="130" Fill="#FFFFD166"
                                 HorizontalAlignment="Center" VerticalAlignment="Bottom" />

                        <StackPanel VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="ACRYLIC BLUR TEST 0123456789"
                                       FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="ACRYLIC BLUR TEST 0123456789"
                                       FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="ACRYLIC BLUR TEST 0123456789"
                                       FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="ACRYLIC BLUR TEST 0123456789"
                                       FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- 上层：元素级 Acrylic 卡片（应把上面的白色文字糊成一片柔光） -->
                        <Border Width="240" Height="130" CornerRadius="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                BorderThickness="1" BorderBrush="#40FFFFFF">
                            <Border.Background>
                                <!--
                                    ⚠️ 实测（2026-09-12 首轮截图）：TintOpacity=0.30 且**不改**
                                       TintLuminosityOpacity（默认 0.8 的白色亮度层）时，
                                       卡片几乎被亮度层糊成一块实心色 —— 下面的内容"看不见但也不像模糊"。
                                       把亮度层设为 0 才是「看得出来是模糊」的配置。
                                -->
                                <AcrylicBrush TintColor="#FF101014"
                                              TintOpacity="0.25"
                                              TintLuminosityOpacity="0.0"
                                              FallbackColor="#CC101014" />
                            </Border.Background>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="元素级 Acrylic"
                                           HorizontalAlignment="Center" FontSize="14" />
                                <TextBlock Text="下面的白字应被糊开"
                                           HorizontalAlignment="Center" FontSize="11"
                                           Opacity="0.8" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ④ 状态栏：把自检结果写在窗口里，便于用户/代理直接读 -->
        <Border Grid.Row="3" Margin="16,10,16,12" Padding="10,8"
                CornerRadius="6" Background="#33000000">
            <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap"
                       Text="正在自检…" />
        </Border>
    </Grid>
</Window>
