<?xml version="1.0" encoding="utf-8"?>
<!--
    MainWindow.xaml —— W3 主界面（真实窗口，不再是 W0 的样板）

    结构：自绘标题栏（拖动区） / 标签栏 / 内容区（网格页或列表页） / 状态栏

    ⚠️ 两条玻璃纪律（血泪，见 ERROR.md E9 / E11）：
      · 根 Grid 必须是 Transparent，**任何一层高不透明度深色底都会把系统材质盖住**；
      · 窗口材质不生效时才由代码补一层纯色兜底，保证文字可读。

    ⚠️ 拖动用 WinUI 原生的 `Window.SetTitleBar(AppTitleBar)` + 系统标题栏按钮：
      这样**保留系统的最小化/最大化/关闭、窗口缩放、贴边分屏与圆角阴影**。
      （QML 时代为了透明被迫去掉 WS_CAPTION 而丢掉缩放，WinUI 3 没有这个取舍。）
-->
<Window
    x:Class="ToolboxPanel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ToolboxPanel.ViewModels">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <!-- 标签栏的一项：图标 + 名称 + 数量 -->
            <DataTemplate x:Key="TabStripItemTemplate" x:DataType="vm:TabItemViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8" Padding="2,0" VerticalAlignment="Center">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                    <TextBlock Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Summary}" FontSize="10" Opacity="0.55" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ① 自绘标题栏（代码里设为拖动区；系统按钮仍在右上角） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10"
                        Margin="16,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE71D;" FontSize="14" />
                <TextBlock Text="ToolboxPanel" FontSize="13" FontWeight="SemiBold" />
                <TextBlock x:Name="BackdropLabel" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ② 标签栏（横向可滚动） -->
        <Border Grid.Row="1" Margin="12,0,12,8" CornerRadius="8"
                Background="#1AFFFFFF" BorderThickness="1" BorderBrush="#22FFFFFF">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled"
                          Padding="4,2">
                <ListView x:Name="TabStrip"
                          ItemTemplate="{StaticResource TabStripItemTemplate}"
                          SelectionMode="Single"
                          SelectionChanged="OnTabSelectionChanged"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          Background="Transparent"
                          BorderThickness="0">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </ScrollViewer>
        </Border>

        <!-- ③ 内容区：网格页 / 列表页在这里切换 -->
        <ContentControl x:Name="ContentHost" Grid.Row="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <!-- ④ 状态栏 -->
        <Border Grid.Row="3" Margin="12,8,12,12" Padding="10,8"
                CornerRadius="6" Background="#33000000">
            <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap" Text="正在载入…" />
        </Border>
    </Grid>
</Window>
