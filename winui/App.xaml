<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ToolboxPanel.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 3 控件默认样式（XamlControlsResources 必须引入） -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!--
                    自绘控件的默认模板：
                    ⚠️ WinUI 3 没有 UWP 那种自动读取 Themes/Generic.xaml 的约定，
                    自绘控件的 Style/Template 必须显式并入应用资源，否则控件是**一片空白**。
                -->
                <ResourceDictionary Source="ms-appx:///Views/TabHiddenSlotView.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
