<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      ⚠️ 必须是 **net9.0-windows**（不能是纯 net9.0）：
        W2 的系统能力要用 COM 互操作（IShellLink / IPersistFile 解析 .lnk），
        而 .NET 5+ 的内置 COM 互操作只在 Windows 专用 TFM 下默认可用。
        本项目本来就只跑 Windows，这样也更准确。
    -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <RootNamespace>ToolboxPanel.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 单测要复用 core 里的 COM 互操作声明（IShellLinkW）去「造」真实 .lnk -->
    <InternalsVisibleTo Include="ToolboxPanel.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      W2 的图标提取要把 HICON 编码成 PNG。
      为什么用 System.Drawing.Common：它就是 GDI+ 的托管封装（Windows 专用），
      `Bitmap.FromHicon` 能正确保留 32bpp 图标的 alpha 通道 —— 这是本项目唯一需要的图像编码能力。
    -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.20" />
  </ItemGroup>

</Project>
